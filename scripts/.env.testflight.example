# Copy to scripts/.env.testflight and replace every placeholder. Do not commit
# the copied file: it contains access to your App Store Connect account.
APP_STORE_CONNECT_KEY_ID=YOUR_KEY_ID
APP_STORE_CONNECT_ISSUER_ID=YOUR_ISSUER_ID
APP_STORE_CONNECT_KEY_FILE=/absolute/path/to/AuthKey_YOUR_KEY_ID.p8
APP_IDENTIFIER=com.qinsbro.telegram
WHAT_TO_TEST=Local feature-preview build
TESTFLIGHT_INTERNAL_GROUP=internal
